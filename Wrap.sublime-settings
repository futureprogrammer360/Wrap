{
    // Default bracket type
    // - 2-character strings: "()", "[]", "{}"
    // - list of [opening, closing]: ["{{ ", " }}"], ["[[ ", " ]]"]
    "bracket_type": "()",

    // Context-specific bracket types (overrides default)
    "contexts": [
        {
            "name": "LaTeX",
            "scope": "text.tex.latex",
            "extensions": ["tex"],
            "bracket_type": "{}"
        }
    ]
}
